{
  "name": "glassbox",
  "version": "0.1.0",
  "description": "X-ray and hygiene monitor for Claude Code AI agent sessions — see what's in your context window, reclaim garbage, compact intelligently.",
  "type": "module",
  "bin": {
    "glassbox": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "build:types": "tsc --build",
    "clean": "rm -rf dist"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "claude",
    "claude-code",
    "ai",
    "context-window",
    "llm",
    "agent",
    "compaction"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kedarvartak/glassbox.git"
  },
  "homepage": "https://github.com/kedarvartak/glassbox#readme",
  "dependencies": {
    "@glassbox/adapter-claude-code": "workspace:*",
    "@glassbox/analysis": "workspace:*",
    "@glassbox/core": "workspace:*",
    "@glassbox/store": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.5.1"
  }
}
