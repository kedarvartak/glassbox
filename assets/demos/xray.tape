# glassbox xray — context composition + reclaimable taxonomy.
# Record: vhs assets/demos/xray.tape
Output assets/demos/xray.gif

Set Shell bash
Set FontSize 13
Set Width 1320
Set Height 1040
Set Padding 22
Set Theme "Catppuccin Mocha"
Set TypingSpeed 45ms

Hide
Type "export PATH=$HOME/.local/bin:$PATH; PS1='$ '; export S=${GLASSBOX_DEMO_SESSION}"
Enter
Type "clear"
Enter
Show

Sleep 700ms
Type "glassbox xray $S"
Sleep 500ms
Enter
Sleep 5s
