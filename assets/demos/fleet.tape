# glassbox index / sessions — fleet-wide monitoring over the SQLite index.
# Record: vhs assets/demos/fleet.tape
Output assets/demos/fleet.gif

Set Shell bash
Set FontSize 13
Set Width 1320
Set Height 430
Set Padding 22
Set Theme "Catppuccin Mocha"
Set TypingSpeed 45ms

Hide
Type "export PATH=$HOME/.local/bin:$PATH; PS1='$ '"
Enter
Type "clear"
Enter
Show

Sleep 700ms
Type "glassbox index"
Sleep 400ms
Enter
Sleep 2500ms

Type "glassbox sessions --limit 8"
Sleep 400ms
Enter
Sleep 5s
